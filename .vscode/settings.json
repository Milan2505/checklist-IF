{
    // Le markdown de ce dépôt est une interface machine (§A.5) : la feuille du
    // vol est lue par js/parser/, pas seulement par un humain. Un formateur qui
    // passe à l'enregistrement réécrit donc le contrat de lecture, sans rien
    // dire — c'est ce qui est arrivé à briefing_prevol_IF_REV25.md, dont les
    // 77 séparateurs de tableaux « |---| » sont devenus « | --- | » tout seuls.
    // Ce coup-là était inoffensif : SEPARATEUR (js/parser/tables.js) tolère les
    // espaces. Le prochain — un retour à la ligne dans une cellule, une
    // réécriture d'emphase — ne le serait pas.
    "[markdown]": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
    },
    // Les règles éteintes et leur motif sont dans .markdownlint.yaml, à la
    // racine. Elles ne sont pas éteintes par confort : voir le fichier.
    "markdownlint.configFile": ".markdownlint.yaml",

    // Le correcteur ne connaissait que l'anglais alors que tout ce dépôt est
    // écrit en français : « préparation », « départ », « croisière » et cent
    // autres sortaient en « Unknown word » sur le seul index.html. Le
    // dictionnaire français (streetsidesoftware.code-spell-checker-french)
    // était déjà installé, mais aucun réglage ne le réclamait — il ne
    // s'active que sur la locale « fr ». On garde « en » à côté : les
    // identifiants du HTML et du JS en vivent (preconnect, crossorigin,
    // viewport, progressbar…).
    "cSpell.language": "fr,en",
    // Les sigles du dossier de vol — OFP, MCDU, APU, ADIRS, ZFW, VFE, FOB — et
    // les codes OACI — LSGG, EDDL, LFMN, EW9743 — forment un ensemble ouvert
    // qui s'allonge à chaque révision livrée. Les lister un par un imposerait
    // de tenir la liste à jour pour rien : aucun dictionnaire n'a d'avis sur
    // eux, ils viennent de l'OFP et du MCDU, pas du français. On cesse donc de
    // vérifier les mots écrits tout en majuscules. Contrepartie assumée : une
    // coquille DANS un sigle passera — mais elle passait déjà, noyée sous les
    // faux positifs.
    "cSpell.ignoreRegExpList": [
        "/\\b[A-ZÀÂÄÇÈÉÊËÎÏÔÖÙÛÜ][A-ZÀÂÄÇÈÉÊËÎÏÔÖÙÛÜ0-9]+\\b/g"
    ],
    // Le vocabulaire du dépôt — SimBrief, aviation, noms propres, et le
    // français forgé par le dossier — vit dans .cspell-mots.txt à la racine,
    // classé par famille et commenté, plutôt qu'en tableau ici. Même partage
    // que .markdownlint.yaml : le réglage pointe, le fichier explique.
    "cSpell.dictionaryDefinitions": [
        {
            "name": "checklist-IF",
            "path": "${workspaceFolder}/.cspell-mots.txt",
            "description": "Vocabulaire SimBrief, aviation et dossier de vol",
            "addWords": true
        }
    ],
    "cSpell.dictionaries": ["checklist-IF"]
}
