<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0A1117">
<meta name="description" content="Checklist de vol Infinite Flight — préparation SimBrief, MCDU, départ, croisière, arrivée et après-vol.">
<title>CHECKLIST VOL — Infinite Flight</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0A1117;
  --panel:#101A21;
  --panel-2:#152229;
  --line:#1E2E37;
  --line-soft:#182630;
  --txt:#E7EEF2;
  --muted:#7E939F;
  --green:#33D67A;    /* normal / fait */
  --amber:#FFB01F;    /* limite, seuil, piege */
  --magenta:#E86BD4;  /* calcule */
  --cyan:#4FD8F5;     /* saisi par le pilote */
  --display:"Barlow Condensed", "Oswald", Impact, sans-serif;
  --body:"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --mono:ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  --r:10px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  background:var(--bg);
  color:var(--txt);
  font-family:var(--body);
  font-size:15px;line-height:1.5;
  padding-bottom:96px;
  background-image:radial-gradient(120% 60% at 50% -10%, #14242e 0%, var(--bg) 60%);
  background-attachment:fixed;
}
.wrap{max-width:760px;margin:0 auto;padding:0 14px}

/* ---------- entete ---------- */
header{
  position:sticky;top:0;z-index:40;
  background:linear-gradient(180deg,rgba(10,17,23,.98) 70%,rgba(10,17,23,.86));
  backdrop-filter:blur(8px);
  border-bottom:1px solid var(--line);
  padding-top:env(safe-area-inset-top);
}
.hdr-top{display:flex;align-items:baseline;gap:10px;padding:12px 0 8px}
.brand{font-family:var(--display);font-weight:700;font-size:21px;letter-spacing:.13em;text-transform:uppercase}
.rev{font-family:var(--mono);font-size:11px;color:var(--amber);border:1px solid #4a3a12;background:#221a08;padding:2px 7px;border-radius:999px;letter-spacing:.06em}
.hdr-top .spacer{flex:1}
.count{font-family:var(--mono);font-size:12px;color:var(--muted)}
.count b{color:var(--green);font-weight:600}

/* ---------- signature : profil de vol ---------- */
.profile{position:relative;padding:2px 0 10px}
.profile svg{display:block;width:100%;height:64px;overflow:visible}
.pf-track{fill:none;stroke:var(--line);stroke-width:1.5}
.pf-done{fill:none;stroke:var(--green);stroke-width:2.5;stroke-linecap:round;
  filter:drop-shadow(0 0 5px rgba(51,214,122,.45));transition:stroke-dasharray .45s ease}
.node{cursor:pointer}
.node circle{transition:all .25s ease}
.node .ring{fill:var(--bg);stroke:var(--line);stroke-width:1.5}
.node.done .ring{stroke:var(--green);fill:#0d2418}
.node.active .ring{stroke:var(--amber);fill:#241a05;r:7}
.node .num{font-family:var(--mono);font-size:8px;fill:var(--muted);text-anchor:middle;dominant-baseline:middle}
.node.done .num{fill:var(--green)}
.node.active .num{fill:var(--amber);font-weight:700}
.pf-label{font-family:var(--display);font-size:11px;letter-spacing:.14em;text-transform:uppercase;fill:var(--amber);text-anchor:middle}

/* ---------- barres ---------- */
.bar{height:3px;background:var(--line-soft);border-radius:2px;overflow:hidden}
.bar span{display:block;height:100%;background:var(--green);width:0;transition:width .3s ease}

/* ---------- boutons outils ---------- */
.tools{display:flex;gap:8px;padding:0 0 12px;flex-wrap:wrap}
.btn{
  font-family:var(--display);font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;
  background:var(--panel);color:var(--txt);border:1px solid var(--line);
  padding:9px 13px;border-radius:var(--r);cursor:pointer;min-height:40px;
}
.btn:hover{border-color:#2d4351}
.btn:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.btn.on{border-color:var(--amber);color:var(--amber)}
.btn.ghost{background:transparent}
.btn.danger:hover{border-color:#7a2b2b;color:#ff8b8b}

/* ---------- panneau valeurs du vol ---------- */
.sheet{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);margin:0 0 14px;overflow:hidden}
.sheet h2{
  font-family:var(--display);font-size:14px;letter-spacing:.16em;text-transform:uppercase;
  margin:0;padding:13px 14px;border-bottom:1px solid var(--line);color:var(--muted);font-weight:600;
}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:9px;padding:12px}
.fld label{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--muted);text-transform:uppercase;margin-bottom:4px}
.fld input{
  width:100%;background:#0A1319;border:1px solid var(--line);color:var(--cyan);
  font-family:var(--mono);font-size:14px;padding:8px 9px;border-radius:7px;min-height:38px;
}
.fld input:focus{outline:none;border-color:var(--cyan)}
.hint{padding:0 12px 12px;font-size:12px;color:var(--muted)}

/* ---------- phases ---------- */
.phase{border:1px solid var(--line);border-radius:var(--r);background:var(--panel);margin-bottom:10px;overflow:hidden}
.phase.active{border-color:#2b4250}
.ph-head{
  display:flex;align-items:center;gap:11px;width:100%;
  background:none;border:0;color:inherit;text-align:left;
  padding:13px 14px;cursor:pointer;min-height:56px;
}
.ph-head:focus-visible{outline:2px solid var(--cyan);outline-offset:-2px}
.ph-idx{font-family:var(--mono);font-size:11px;color:var(--muted);width:20px;flex:none}
.phase.complete .ph-idx{color:var(--green)}
.ph-title{font-family:var(--display);font-size:17px;letter-spacing:.07em;text-transform:uppercase;font-weight:600;flex:1;line-height:1.15}
.ph-sub{display:block;margin-top:3px;font-family:var(--body);font-size:11.5px;letter-spacing:0;
  text-transform:none;font-weight:400;color:var(--muted);line-height:1.35}
.phase.complete .ph-title{color:var(--green)}
.ph-count{font-family:var(--mono);font-size:11px;color:var(--muted);flex:none}
.chev{width:9px;height:9px;border-right:1.5px solid var(--muted);border-bottom:1.5px solid var(--muted);
  transform:rotate(45deg);margin-left:2px;flex:none;transition:transform .2s}
.phase.open .chev{transform:rotate(-135deg)}
.ph-bar{padding:0 14px 11px}
.ph-body{display:none;padding:2px 0 6px;border-top:1px solid var(--line-soft)}
.phase.open .ph-body{display:block}

/* ---------- items ---------- */
.item{
  display:flex;gap:12px;align-items:flex-start;width:100%;
  background:none;border:0;border-bottom:1px solid var(--line-soft);color:inherit;text-align:left;
  padding:13px 14px;cursor:pointer;min-height:52px;font-family:var(--body);font-size:15px;
}
.item:last-child{border-bottom:0}
.item:focus-visible{outline:2px solid var(--cyan);outline-offset:-2px}
.box{
  width:21px;height:21px;flex:none;margin-top:1px;border-radius:5px;
  border:1.5px solid #3b5060;position:relative;transition:all .18s;
}
.item.warn .box{border-color:#6a5316}
.item.done .box{background:var(--green);border-color:var(--green)}
.item.done .box::after{
  content:"";position:absolute;left:6.5px;top:2.5px;width:5px;height:10px;
  border:solid #06210f;border-width:0 2.2px 2.2px 0;transform:rotate(42deg);
}
.it-txt{flex:1;min-width:0}
.it-t{display:block}
.item.warn .it-t::before{content:"⚠ ";color:var(--amber)}
.item.done .it-t{color:var(--muted);text-decoration:line-through;text-decoration-color:#2c4a39}
.it-d{display:block;font-size:13px;color:var(--muted);margin-top:3px;line-height:1.45}
.item.done .it-d{opacity:.5}
.val{font-family:var(--mono);color:var(--cyan);font-size:13.5px}
.val.empty{color:#5d7280}
.ref{
  flex:none;font-family:var(--mono);font-size:10.5px;color:var(--magenta);
  border:1px solid #43244a;background:#1c1022;border-radius:6px;padding:3px 6px;margin-top:1px;
  cursor:pointer;-webkit-appearance:none;appearance:none;line-height:1.25;font-weight:500;
}
.ref:hover{border-color:var(--magenta)}
.ref:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
/* dossier charge : la pastille dit si sa section est dans le fichier */
.ref.ok{border-color:var(--magenta)}
.ref.miss{color:#4e5c66;border-color:#212d35;background:#0d151a}
.ref.miss:hover{border-color:#2f3f4a}

/* ---------- lecteur de section ---------- */
.drawer{
  position:fixed;inset:0;z-index:60;display:none;
  background:rgba(4,8,11,.72);backdrop-filter:blur(3px);
}
.drawer.open{display:block}
.dr-panel{
  position:absolute;left:0;right:0;bottom:0;max-height:84vh;overflow:auto;overscroll-behavior:contain;
  background:var(--panel-2);border-top:1px solid var(--line);
  border-radius:16px 16px 0 0;padding:0 16px calc(28px + env(safe-area-inset-bottom));
  animation:up .22s ease;
}
@keyframes up{from{transform:translateY(22px);opacity:.4}to{transform:none;opacity:1}}
.dr-head{position:sticky;top:0;background:var(--panel-2);display:flex;align-items:center;gap:10px;padding:14px 0 10px;border-bottom:1px solid var(--line)}
.dr-head h3{margin:0;flex:1;font-family:var(--display);font-size:16px;letter-spacing:.12em;text-transform:uppercase}
.md{font-size:14.5px;line-height:1.62;padding-top:12px}
.md h1,.md h2,.md h3{font-family:var(--display);letter-spacing:.09em;text-transform:uppercase;margin:20px 0 8px;font-size:16px;color:var(--txt)}
.md p{margin:9px 0}
.md ul,.md ol{margin:9px 0;padding-left:19px}
.md li{margin:5px 0}
.md code{font-family:var(--mono);font-size:13px;background:#0a141a;border:1px solid var(--line);padding:1px 5px;border-radius:5px;color:var(--cyan)}
.md pre{font-family:var(--mono);font-size:12.5px;background:#091217;border:1px solid var(--line);padding:11px;border-radius:8px;overflow:auto;white-space:pre;color:#a9c3d0}
.md table{width:100%;border-collapse:collapse;margin:11px 0;font-size:13px}
.md th,.md td{border:1px solid var(--line);padding:6px 8px;text-align:left}
.md th{background:#0d181e;font-family:var(--mono);font-size:11px;letter-spacing:.05em;color:var(--muted);text-transform:uppercase}
.md .w{color:var(--amber)}
.md strong{color:#fff}
.empty-state{padding:26px 0 10px;color:var(--muted);font-size:14px}

/* ---------- pied ---------- */
.foot{
  position:fixed;left:0;right:0;bottom:0;z-index:30;
  background:linear-gradient(180deg,rgba(10,17,23,.5),rgba(10,17,23,.97) 40%);
  border-top:1px solid var(--line);
  padding:9px 14px calc(9px + env(safe-area-inset-bottom));
}
.foot-in{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px}
.foot .lbl{font-family:var(--display);font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);flex:none}
.foot .bar{flex:1}
.foot .pct{font-family:var(--mono);font-size:13px;color:var(--green);flex:none;min-width:38px;text-align:right}
.toast{
  position:fixed;left:50%;transform:translateX(-50%);bottom:78px;z-index:70;
  background:var(--panel-2);border:1px solid var(--line);color:var(--txt);
  padding:9px 14px;border-radius:999px;font-size:13px;opacity:0;pointer-events:none;transition:opacity .25s
}
.toast.show{opacity:1}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-family:var(--mono);font-size:10.5px;color:var(--muted);padding:2px 2px 16px}
.legend i{width:8px;height:8px;border-radius:2px;display:inline-block;margin-right:5px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="hdr-top">
      <div class="brand">Checklist vol</div>
      <div class="rev" id="revTag">REV 11</div>
      <div class="spacer"></div>
      <div class="count" id="hdrCount"><b>0</b>/0</div>
    </div>
    <div class="profile">
      <svg id="pf" viewBox="0 0 1000 64" preserveAspectRatio="none" aria-hidden="true">
        <path id="pfPath" class="pf-track" d="M 14 56 L 120 56 C 210 56 235 12 340 12 L 660 12 C 770 12 800 50 880 56 L 986 56"/>
        <path id="pfDone" class="pf-done" d="M 14 56 L 120 56 C 210 56 235 12 340 12 L 660 12 C 770 12 800 50 880 56 L 986 56"/>
        <g id="pfNodes"></g>
      </svg>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="tools">
    <button type="button" class="btn" id="btnLoad">Charger le briefing</button>
    <button type="button" class="btn ghost" id="btnValues" aria-expanded="false" aria-controls="valuesSheet">Valeurs du vol</button>
    <button type="button" class="btn ghost" id="btnOpen" aria-pressed="false">Tout déplier</button>
    <button type="button" class="btn ghost danger" id="btnReset">Nouveau vol</button>
    <input type="file" id="file" accept=".md,.markdown,.txt" hidden>
  </div>

  <section class="sheet" id="valuesSheet" hidden>
    <h2>Valeurs du vol</h2>
    <div class="grid" id="valGrid"></div>
    <p class="hint">Ces valeurs s'affichent dans les lignes de la checklist là où elles servent. Elles viennent de l'OFP et du MCDU — tapez-les une fois, elles suivent tout le vol.</p>
  </section>

  <div id="phases"></div>

  <div class="legend">
    <span><i style="background:var(--green)"></i>fait</span>
    <span><i style="background:var(--amber)"></i>limite ou piège</span>
    <span><i style="background:var(--magenta)"></i>renvoi au dossier</span>
    <span><i style="background:var(--cyan)"></i>valeur saisie</span>
  </div>
</main>

<div class="foot">
  <div class="foot-in">
    <span class="lbl" id="footPhase">Vol</span>
    <div class="bar" role="progressbar" aria-label="Avancement du vol" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="footBar"></span></div>
    <span class="pct" id="footPct">0%</span>
  </div>
</div>

<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drTitle" aria-hidden="true">
  <div class="dr-panel">
    <div class="dr-head">
      <h3 id="drTitle">Section</h3>
      <button type="button" class="btn ghost" id="drClose">Fermer</button>
    </div>
    <div class="md" id="drBody"></div>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

<script>
/* ============================================================
   CONTENU — tire du BRIEFING PRE-VOL INFINITE FLIGHT, REV 11
   t : ligne de checklist · d : detail · r : renvoi · w : point de vigilance
   {{cle}} : valeur du vol, saisie dans le panneau Valeurs
============================================================ */
const FIELDS = [
  ['callsign','Callsign'],['route','DEP → ARR'],['type','Type / immat'],
  ['piste','Piste dép.'],['v1','V1'],['vr','VR'],['v2','V2'],
  ['flex','Flex °C'],['volets','Volets dép.'],['thrred','Réduction ft'],['accel','Accél. ft'],
  ['fl','Croisière FL'],['bloc','Bloc kg'],['bingo','BINGO kg'],['mindiv','MIN DIV kg'],
  ['arrpiste','Piste arr.'],['ils','ILS'],['da','DA ft'],['lw','LW t'],
  ['vref','Vref kt'],['vapp','Vapp kt'],['inbound','Inbound NM'],['inbwpt','Point inbound'],
  ['degag','Dégagement'],['degcap','Cap dégag.'],['degdist','Dist. dégag. NM']
];

const PHASES = [
  { n:"Feuille SimBrief", s:"Saisie du formulaire, avant génération", items:[
    {t:"Flight Info saisi", d:"Airline, Flight Number, Depart · Arrive, EOBT en UTC.", r:"0"},
    {t:"Dégagement nommé dans Alternate", d:"Jamais AUTO : c'est le terrain à briefer, il doit tenir la météo de l'ETA.", r:"0", w:1},
    {t:"Aircraft Info saisi", d:"Type dans la variante exacte volée dans IF, Airframe générique, ATC Callsign identique à celui d'IF, Fuel Factor P00, immatriculation.", r:"0", w:1},
    {t:"Champs secondaires traités", d:"Fin Number, SELCAL, Mode-S remplis. Equipment, transpondeur, PBN et item 18 laissés aux valeurs grisées : ils n'entrent dans aucun calcul.", r:"0"},
    {t:"Selections vérifiées", d:"LIDO · Kilograms · Detailed · Taxi 20/8 · IFR · Scheduled · 1 alternate.", r:"0"},
    {t:"Les six interrupteurs sur ON", d:"Detailed Navlog, ETOPS Planning, Plan Stepclimbs, Runway Analysis, Include NOTAMs, FIR NOTAMs. En éteindre un rouvre un trou que rien ne comble.", r:"0", w:1},
    {t:"Fenêtre AIRAC vérifiée", d:"Un cycle en avance sur la base d'IF fait refuser un waypoint à l'import.", r:"0"},
    {t:"Optional Entries chiffrés", d:"Sched Block Time, Altitude (FL retenu), Passengers, Freight, Payload. Aucune case en AUTO.", r:"0"},
    {t:"ZFW forcé", d:"Masse à vide d'IF pour le type + payload. Laisser AUTO, c'est planifier un avion qui n'existe pas.", r:"0", w:1},
    {t:"Pistes laissées en AUTO", d:"AUTO choisit au vent réel, comme IF. La piste attendue se note pour comparaison, elle ne se tape pas.", r:"0"},
    {t:"Fuel Planning réglé", d:"MEL, ATC, WXX et Tankering à 0. EXTRA non nul seulement avec un motif écrit.", r:"0"},
    {t:"Text Entries remplis", d:"Pilot ID, Captain Name, et dans les remarks : piste attendue, seuil BINGO, dégagement.", r:"0"},
    {t:"Route collée dans Selected Route", d:"Format ATC, sans les terrains.", r:"0"},
    {t:"Alternate Airports réglé", d:"Critères 400 / 600 / 3000 / 7000, dégagement en DCT. Takeoff et Enroute seulement si le vol l'exige.", r:"0"},
    {t:"ETOPS traité", d:"n/a sur vol continental. Sinon Threshold 60 min, Scenario Auto, puis Calculate.", r:"0"},
    {t:"OFP généré", d:"À partir de là c'est l'OFP qui fait foi, y compris s'il a retenu autre chose que ce qui était proposé.", r:"0", w:1}
  ]},

  { n:"OFP & cartouche", s:"Lecture du plan, seuils carburant", items:[
    {t:"Cartouche rempli", d:"Piste {{piste}} · V1/VR/V2 {{v1}}/{{vr}}/{{v2}} · Flex {{flex}} · Volets {{volets}} · Bloc {{bloc}} · ILS {{ils}} · DA {{da}} · Vapp {{vapp}} · Dégagement {{degag}}.", r:"A.4"},
    {t:"Masses dans les limites", d:"TOW sous MTOW et LW sous MLW. Hors limite = NO-GO, sans discussion.", r:"8", w:1},
    {t:"Bloc supérieur à la somme des postes", d:"Sinon NO-GO.", r:"8", w:1},
    {t:"Route contrôlée", d:"Aucun waypoint dupliqué, FL conforme à la règle semi-circulaire. SimBrief ne signale ni l'un ni l'autre.", r:"1", w:1},
    {t:"MIN DIV calculé", d:"Dégagement + réserve finale = {{mindiv}}.", r:"3"},
    {t:"BINGO calculé", d:"MIN DIV + 5 % = {{bingo}}. En dessous, la décision de dérouter se prend, elle ne se discute plus.", r:"3"},
    {t:"Points de contrôle carburant choisis", d:"Deux ou trois waypoints du navlog, à comparer à la jauge en vol.", r:"3"},
    {t:"Météo des trois terrains lue", d:"METAR et TAF départ, arrivée, dégagement. Minima d'arrivée contre la météo prévue à l'ETA.", r:"6"},
    {t:"NOTAM lus", d:"Départ, arrivée, dégagement, FIR.", r:"1"},
    {t:"OFP de moins de 2 h", d:"Au-delà, la météo et les vents ne valent plus.", r:"8"}
  ]},

  { n:"Import & MCDU", s:"Les trois contrôles qui décident si le vol est préparé", items:[
    {t:"Import SimBrief lancé, F-PLN affichée", d:"FROM/TO, FLT NBR, CI, ZFW, BLOCK, CRZ FL, piste, FLAPS/THS, FLEX, V1/VR/V2 et la page APPR arrivent seuls. On relit, on ne retape pas.", r:"2.1"},
    {t:"① Distance MCDU ≈ distance OFP", d:"Écart toléré 10 NM ou 2 %. 0.0 NM après import = route NON construite : rien d'autre ne se paramètre avant correction.", r:"2.2", w:1},
    {t:"② Vitesses cohérentes et pour la bonne piste", d:"V1 ≤ VR ≤ V2. V1 = VR est normal ; seul V1 > VR est une erreur.", r:"2.2", w:1},
    {t:"Masse réelle contrôlée", d:"GW en FUEL PRED comparée à l'ETOW : le ZFW s'importe faux (2,1 t constatées sur A318). Marge au MTOW à vérifier sur la masse réelle.", r:"2.3", w:1},
    {t:"③ Croisière saisie", d:"CRZ FL/TEMP au format FL350/-54 sur INIT 1/2 ou PERF CRUISE. L'altitude sélectionnée au pilote automatique bouge avec : la revérifier.", r:"2.2", w:1},
    {t:"ALTN saisi à la main sur INIT 1/2", d:"L'import ne l'apporte pas. Appui LSK à scratchpad vide pour restaurer la valeur SimBrief.", r:"2.1"},
    {t:"Contraintes d'altitude saisies et relues", d:"Via VERT REV. Le magenta sur la F-PLN ne prouve rien : seul ALT CSTR renseigné confirme une contrainte.", r:"2.1", w:1},
    {t:"Contraintes de vitesse notées à part", d:"Elles n'existent pas dans le MCDU. À tenir au sélecteur du pilote automatique.", r:"2.1"},
    {t:"Page APPR relue", d:"Piste {{arrpiste}}, ILS {{ils}}, fréquence, TRANS LVL (affiché sans préfixe FL), VAPP, LDG CONF.", r:"2.1"},
    {t:"Écart Vapp arbitré", d:"Vapp du MCDU observée 11 kt sous SimBrief. Écart supérieur à 5 kt : c'est la valeur SimBrief qui se tient au sélecteur.", r:"2.3", w:1},
    {t:"Scratchpad vide, aucun message ambre", d:"Dernier contrôle avant repoussage.", r:"2.2"}
